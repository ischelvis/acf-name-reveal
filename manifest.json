{
  "manifest_version": 3,
  "name": "ACF Name Reveal",
  "description": "Reveal ACF field names directly on their input fields.",
  "version": "1.0.0",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*/wp*"],
      "js": ["src/initFieldNameDisplay.ts"],
      "world": "MAIN"
    }
  ]
}
